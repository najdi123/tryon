# Copy to ".env.local" and fill in. Never commit .env.local. No real value belongs in this file.

# PostgreSQL 16. The app's own database and role.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/ayeneh

# The public address, without a trailing slash. Gallery QR codes are printed with it,
# so it must be the address customers will open. Required in production.
PUBLIC_BASE_URL=https://example.com

# Google AI Studio key for the image model (a paid key: the free tier makes no pictures).
# Without it the app still works for shades close to the customer's own hair colour.
GEMINI_API_KEY=

# Optional. Defaults shown.
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# AI_TRYONS_PER_VISITOR_PER_DAY=30
# AI_TRYONS_SITE_PER_DAY=2000

# Development only: keep before and after pictures for review (see README). Never on for real customers.
# RECORD_TRYONS=1
# RECORD_DIR=/root/ayeneh-records
